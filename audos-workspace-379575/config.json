          }
        },
        {
          "kind": "features",
          "variant": "cards",
          "eyebrow": "Inside the playground",
          "heading": "From motion idea to moving scene—without the friction.",
          "items": [
            {
              "title": "Say it in Easy mode",
              "body": "Describe any scene in any language. NeoFlash generates valid scene code and the SVG runtime brings it to life in seconds.",
              "icon": "compass"
            },
            {
              "title": "Own the motion in Advanced mode",
              "body": "Drop into the declarative NeoFlash language when you want control. Edit primitives, symbols, timelines, and click events while the browser renders every vector live.",
              "icon": "sparkles"
            },
            {
              "title": "Generate a scene. Keep every version.",
              "body": "Describe, generate, save, and reload your work directly in the playground. Your scenes persist, ready to reopen and remix whenever the next electric idea hits.",
              "icon": "rocket"
            }
          ]
        },
        {
          "kind": "cta",
          "variant": "card",
          "heading": "Your next scene is one sentence away.",
          "body": "Open the cyberpunk playground, describe the motion in your head, and watch it move—all vector, all browser-native.",
