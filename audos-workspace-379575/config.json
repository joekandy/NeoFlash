          "eyebrow": "THE WEB GETS WEIRD AGAIN",
          "heading": "Describe it. Animate it. Instantly.",
          "body": "Type a neon bar at night, a bouncing ball, or a passing car. NeoFlash turns your idea into live vector motion in seconds—no plugins, heavy software, or blank canvas.",
          "primaryAction": {
            "type": "open-login",
            "label": "Open NeoFlash"
          },
          "media": {
            "type": "video",
